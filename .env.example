# ------------------------------------------------------------------
# Nicoli Sociedade de Advogados — variáveis de ambiente
# Copie para .env.local (dev) e cadastre as mesmas na Vercel (Production + Preview).
# Todas as NEXT_PUBLIC_* vão para o bundle do navegador: NUNCA coloque segredos aqui.
# ------------------------------------------------------------------

# URL canônica do site (sem barra no final). Usada em SEO, sitemap e no container GTM.
NEXT_PUBLIC_SITE_URL=https://nicoliadvogados.adv.br

# Google Tag Manager (formato GTM-XXXXXXX). Sem ele, nenhum script de terceiro é carregado.
NEXT_PUBLIC_GTM_ID=

# GA4 — ID de medição (G-XXXXXXXXXX). O site NÃO carrega o GA4 direto: ele é
# configurado DENTRO do GTM. Aqui serve para o gerador do container (gtm/gen-container.mjs).
NEXT_PUBLIC_GA4_ID=

# Meta Pixel (apenas números). Também configurado dentro do GTM, com consentimento.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads — ID da conta de conversão (AW-XXXXXXXXX). Usado pelo gerador do container.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Rótulos (labels) das ações de conversão do Google Ads — só para o gerador do container
# (não são lidos pelo site). Ficam em: Google Ads > Metas > Conversões > ação > Configuração da tag.
GOOGLE_ADS_LABEL_GENERATE_LEAD=
GOOGLE_ADS_LABEL_CLICK_WHATSAPP=
GOOGLE_ADS_LABEL_CLICK_PHONE=

# Link "Avalie no Google" / perfil de avaliações (Google Business Profile).
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
